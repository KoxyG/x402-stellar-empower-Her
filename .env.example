# ════════════════════════════════════════════════════════════
#  x402 on Stellar workshop kit: ALL configuration lives here.
#  Your own copy (.env) is created by: npm run setup
# ════════════════════════════════════════════════════════════

# ── Network (TESTNET ONLY for this workshop) ───────────────
STELLAR_NETWORK=stellar:testnet
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
# Horizon: reads classic accounts, balances and trustlines (used by setup + check)
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# Stellar RPC (formerly "Soroban RPC"): talks to smart contracts. USDC is a contract,
# so the x402 payment (simulate + sign the transfer) goes through here.
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_EXPLORER_URL=https://stellar.expert/explorer/testnet

# ── USDC (Circle testnet) ──────────────────────────────────
USDC_ASSET_CODE=USDC
# Classic issuer (G...): used for trustlines
USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
# SEP-41 contract (C...): what x402 calls transfer on
USDC_CONTRACT_ID=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
# USDC on Stellar has 7 decimals (not 6 like on EVM chains)
USDC_DECIMALS=7
USDC_FAUCET_URL=https://faucet.circle.com

# ── Wallets (npm run setup fills these in) ─────────────────
# Server wallet: receives payments (G...).
STELLAR_RECIPIENT=
# Server wallet secret: saved so you can manage received funds. The app never uses it.
STELLAR_RECIPIENT_SECRET=
# Agent wallet: pays (S...). NEVER share, commit or show on screen.
# Fund it only with what the agent may spend: its USDC balance is the hard limit.
STELLAR_SECRET_KEY=

# ── Facilitator ────────────────────────────────────────────
# Which one is active: primary | backup   (switching on stream = change this line)
FACILITATOR=primary

# Primary: Build on Stellar facilitator (OpenZeppelin). Needs a free key.
FACILITATOR_PRIMARY_URL=https://channels.openzeppelin.com/x402/testnet
FACILITATOR_PRIMARY_API_KEY=
FACILITATOR_PRIMARY_KEY_URL=https://channels.openzeppelin.com/testnet/gen

# Backup: Coinbase facilitator (testnet only, no key).
FACILITATOR_BACKUP_URL=https://x402.org/facilitator


# ── Agent spending rules (Layer 1) ─────────────────────────
# The most one task may spend in total (USD)
AGENT_TASK_BUDGET_USD=0.05
# The most any single request may cost (USD). Anything pricier is refused.
AGENT_MAX_PER_REQUEST_USD=0.02
# Services the agent may pay, comma-separated host:port
AGENT_ALLOWED_HOSTS=localhost:4021

# ── Server ─────────────────────────────────────────────────
PORT=4021
# Where the client, agent and console find the paid API
API_BASE_URL=http://localhost:4021
# The agent console (buyer side) runs here
CONSOLE_PORT=4022
